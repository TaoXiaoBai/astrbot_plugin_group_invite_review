{
  "enable": {
    "description": "启用插件",
    "type": "bool",
    "default": true,
    "hint": "关闭后只记录邀请，不接管事件"
  },
  "auto_approve": {
    "description": "自动同意进群",
    "type": "bool",
    "default": false,
    "hint": "LLM 判断要加时直接同意；关闭则只通知你"
  },
  "auto_reject": {
    "description": "自动拒绝邀请",
    "type": "bool",
    "default": false,
    "hint": "LLM 判断不要加时直接拒绝；关闭则只通知你"
  },
  "notify_private": {
    "description": "私聊通知管理员",
    "type": "bool",
    "default": true
  },
  "notify_private_qq": {
    "description": "通知的 QQ 号",
    "type": "string",
    "default": "",
    "hint": "留空则用全局管理员"
  },
  "notify_group": {
    "description": "在群里通知",
    "type": "bool",
    "default": false
  },
  "notify_group_id": {
    "description": "通知群号",
    "type": "string",
    "default": ""
  },
  "llm_provider_id": {
    "description": "决策用的模型",
    "type": "string",
    "default": "",
    "hint": "留空则用默认模型"
  },
  "decision_persona": {
    "description": "决策用人格",
    "type": "string",
    "default": "",
    "options": ["", "Sydney", "LittleSkin支持"],
    "labels": ["自动（默认）", "Sydney", "LittleSkin支持"],
    "hint": "LLM 按这个人格的性格做判断"
  },
  "enable_member_context": {
    "description": "参考群成员",
    "type": "bool",
    "default": true,
    "hint": "把目标群的成员列表给 LLM 参考"
  },
  "enable_impression_context": {
    "description": "参考历史印象",
    "type": "bool",
    "default": true,
    "hint": "从历史群聊/私聊里找对邀请人的印象"
  },
  "truncate_marker": {
    "description": "截断占位符",
    "type": "string",
    "default": "…"
  },
  "enable_private_intent": {
    "description": "检测私聊加群意图",
    "type": "bool",
    "default": true,
    "hint": "私聊问能否加群、发邀请链接也会被识别"
  },
  "private_intent_reply": {
    "description": "回复私聊邀请",
    "type": "bool",
    "default": true
  },
  "private_intent_notify": {
    "description": "通知私聊邀请",
    "type": "bool",
    "default": true
  },
  "reply_inviter_on_decision": {
    "description": "回复邀请人",
    "type": "bool",
    "default": true,
    "hint": "同意/拒绝前先私聊邀请人一句再处理"
  },
  "revenge_mode": {
    "description": "被踢报复方式",
    "type": "string",
    "default": "off",
    "options": ["off", "delete_friend", "delete_and_ban"],
    "labels": ["关闭", "删除并拉黑", "删除并加黑名单"]
  },
  "revenge_notify": {
    "description": "被踢通知管理员",
    "type": "bool",
    "default": true,
    "hint": "查不到邀请人时也会通知"
  },
  "kick_ban_operator": {
    "description": "拉黑踢人者",
    "type": "bool",
    "default": false,
    "hint": "被踢时把执行踢人的人也拉黑"
  },
  "record_group_join": {
    "description": "记录进群",
    "type": "bool",
    "default": true,
    "hint": "记录每次进群的时间和操作人"
  },
  "cross_group_retaliation": {
    "description": "跨群连坐",
    "type": "bool",
    "default": false,
    "hint": "被踢/禁言达阈值时，退出该邀请人邀请的所有群"
  },
  "mute_retaliation_enable": {
    "description": "禁言自动报复",
    "type": "bool",
    "default": false,
    "hint": "被禁言达到次数后自动退群并拉黑"
  },
  "mute_threshold": {
    "description": "禁言次数阈值",
    "type": "int",
    "default": 3,
    "hint": "被禁言几次后触发退群拉黑"
  },
  "mute_target": {
    "description": "禁言拉黑对象",
    "type": "string",
    "default": "operator",
    "options": ["operator", "inviter", "both"],
    "labels": ["禁言者", "邀请人", "都拉黑"]
  },
  "mute_ban_mode": {
    "description": "禁言拉黑方式",
    "type": "string",
    "default": "astrbot_ban",
    "options": ["astrbot_ban", "delete_friend"],
    "labels": ["加黑名单", "删好友并拉黑"]
  },
  "mute_notify": {
    "description": "禁言通知管理员",
    "type": "bool",
    "default": true
  },
  "ban_notice_message": {
    "description": "拉黑前留言",
    "type": "string",
    "default": "",
    "hint": "拉黑前私聊发给对方的话，留空不发"
  },
  "llm_context_inject": {
    "description": "注入封禁记录",
    "type": "bool",
    "default": true,
    "hint": "让 LLM 聊天时知道谁有前科"
  },
  "llm_tool_ban": {
    "description": "LLM 主动拉黑",
    "type": "bool",
    "default": true,
    "hint": "允许 LLM 自主拉黑/解封/查询"
  },
  "llm_tool_require_admin": {
    "description": "LLM 拉黑需管理员",
    "type": "bool",
    "default": false
  },
  "invite_records_show_profile": {
    "description": "显示邀请人头像昵称",
    "type": "bool",
    "default": true
  },
  "invite_records_show_group_profile": {
    "description": "显示群头像群名",
    "type": "bool",
    "default": true
  }
}
