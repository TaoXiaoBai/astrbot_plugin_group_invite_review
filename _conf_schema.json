{
  "enable": {
    "description": "是否启用本插件",
    "type": "bool",
    "default": true
  },
  "auto_approve": {
    "description": "判断要加时，是否自动同意进群",
    "type": "bool",
    "default": false
  },
  "auto_reject": {
    "description": "判断不要加时，是否自动拒绝",
    "type": "bool",
    "default": false
  },
  "notify_private": {
    "description": "是否私聊通知管理员",
    "type": "bool",
    "default": true
  },
  "notify_private_qq": {
    "description": "通知管理员的 QQ 号（留空用全局管理员）",
    "type": "string",
    "default": ""
  },
  "notify_group": {
    "description": "是否在指定群通知",
    "type": "bool",
    "default": false
  },
  "notify_group_id": {
    "description": "通知群号",
    "type": "string",
    "default": ""
  },
  "llm_provider_id": {
    "description": "判断用的模型（留空用默认）",
    "type": "string",
    "default": ""
  },
  "enable_member_context": {
    "description": "是否参考目标群成员",
    "type": "bool",
    "default": true
  },
  "enable_impression_context": {
    "description": "是否参考历史印象",
    "type": "bool",
    "default": true
  },
  "truncate_marker": {
    "description": "截断时的占位符",
    "type": "string",
    "default": "…"
  },
  "decision_persona": {
    "description": "决策用人格（留空=自动用当前账号默认人格）",
    "type": "string",
    "default": "",
    "options": ["", "Sydney", "LittleSkin支持"],
    "labels": ["自动（默认）", "Sydney", "LittleSkin支持"]
  },
  "enable_private_intent": {
    "description": "是否检测私聊加群意图",
    "type": "bool",
    "default": true
  },
  "private_intent_reply": {
    "description": "检测到意图时是否回复对方",
    "type": "bool",
    "default": true
  },
  "private_intent_notify": {
    "description": "检测到意图时是否通知管理员",
    "type": "bool",
    "default": true
  },
  "revenge_mode": {
    "description": "被踢后的报复方式",
    "type": "string",
    "default": "off",
    "options": ["off", "delete_friend", "delete_and_ban"],
    "labels": ["关闭", "删除并拉黑", "删除并加入AstrBot黑名单"]
  },
  "revenge_notify": {
    "description": "报复后是否通知管理员",
    "type": "bool",
    "default": true
  },
  "mute_retaliation_enable": {
    "description": "被禁言达到次数后自动退群并拉黑",
    "type": "bool",
    "default": false
  },
  "mute_threshold": {
    "description": "被禁言达到该次数触发退群拉黑",
    "type": "int",
    "default": 3
  },
  "mute_target": {
    "description": "拉黑对象",
    "type": "string",
    "default": "operator",
    "options": ["operator", "inviter", "both"],
    "labels": ["禁言者", "邀请人", "都拉黑"]
  },
  "mute_ban_mode": {
    "description": "拉黑方式",
    "type": "string",
    "default": "astrbot_ban",
    "options": ["astrbot_ban", "delete_friend"],
    "labels": ["加入AstrBot黑名单", "删除好友并拉黑"]
  },
  "mute_notify": {
    "description": "被禁言/报复后是否通知管理员",
    "type": "bool",
    "default": true
  },
  "ban_notice_message": {
    "description": "拉黑前私聊发给邀请人的话（留空不发）",
    "type": "string",
    "default": ""
  },
  "llm_context_inject": {
    "description": "把封禁/邀请/禁言记录注入 LLM 上下文",
    "type": "bool",
    "default": true
  },
  "llm_tool_ban": {
    "description": "允许 LLM 主动拉黑/解封/查询",
    "type": "bool",
    "default": true
  },
  "llm_tool_require_admin": {
    "description": "LLM 拉黑/解封是否需要管理员身份",
    "type": "bool",
    "default": false
  },
  "invite_records_show_profile": {
    "description": "邀请记录图片里显示邀请人头像和昵称",
    "type": "bool",
    "default": true
  },
  "invite_records_show_group_profile": {
    "description": "邀请记录图片里显示群头像和群名",
    "type": "bool",
    "default": true
  }
}
